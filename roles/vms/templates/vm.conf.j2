{{ ansible_managed | comment }}
{#
  The systemd unit reads this file as an EnvironmentFile and passes $QEMU_ARGS
  to /usr/libexec/qemu-kvm unquoted, so systemd splits the value at each space.
  An argument must therefore never contain a space. Where a value can, the role
  writes it to a file and passes the path (see the SMBIOS block below).

  Every `item` key is already resolved: `vars/main.yml` merged the per-VM keys
  over the role defaults, so this template never needs `| default(...)`.
#}
{% set _args = [] %}
{% set _ = _args.append('-name ' ~ item.name) %}
{% if item.secure_boot %}
{#- SMM is what keeps the guest out of the variable store. -#}
{% set _ = _args.append('-machine q35,accel=kvm,smm=on') %}
{% else %}
{% set _ = _args.append('-machine q35,accel=kvm') %}
{% endif %}
{% set _ = _args.append('-m ' ~ item.memory) %}
{% set _ = _args.append('-smp ' ~ item.cpus) %}
{% set _ = _args.append('-cpu ' ~ item.cpu_model) %}
{# ── Consoles and control socket ──────────────────────────
  -display none makes the arguments below the only source of truth for a
  console. -nographic would mux a monitor onto stdio, which hides where a
  console goes.

  QMP is the whole control channel. It answers with typed results and
  structured errors, and it carries the human monitor commands through
  human-monitor-command, so nothing is lost by having no -monitor.

  server=on,wait=off lets QEMU create each socket and carry on. With wait=on
  the process stops before it opens its QMP socket, and it never starts.
#}
{% set _ = _args.append('-display none') %}
{% set _ = _args.append('-chardev socket,id=ser0,path=' ~ item.serial_socket ~ ',server=on,wait=off') %}
{% set _ = _args.append('-serial chardev:ser0') %}
{#- An empty vnc_address binds every interface, which is what -vnc :N does. -#}
{% set _ = _args.append('-vnc ' ~ (item.vnc_address or '') ~ ':' ~ item.vnc) %}
{% set _ = _args.append('-qmp unix:' ~ item.qmp_socket ~ ',server=on,wait=off') %}
{# ── System disk ─────────────────────────────────────────── #}
{% set _disk_file = vms_image_dir ~ '/' ~ item.name ~ '.' ~ item.disk_format %}
{% if item.disk_bus == 'virtio-scsi' %}
{% set _ = _args.append('-device virtio-scsi-pci,id=scsi0') %}
{% set _ = _args.append('-drive if=none,id=disk0,format=' ~ item.disk_format ~ ',file=' ~ _disk_file) %}
{#- bootindex 2 keeps the USB device (bootindex 1) ahead of the system disk. -#}
{% set _ = _args.append('-device scsi-hd,drive=disk0,bus=scsi0.0,bootindex=2') %}
{% else %}
{% set _ = _args.append('-drive if=virtio,format=' ~ item.disk_format ~ ',file=' ~ _disk_file) %}
{% endif %}
{# ── cloud-init seed ISO ─────────────────────────────────── #}
{% if item.cloud_init_user_data is defined or item.cloud_init_meta_data is defined or item.cloud_init_network_config is defined %}
{% set _ = _args.append('-drive if=virtio,format=raw,file=' ~ vms_image_dir ~ '/' ~ item.name ~ '-seed.iso,media=cdrom,readonly=on') %}
{% endif %}
{# ── USB disk image ──────────────────────────────────────── #}
{% if item.usb_disk_image is defined and item.usb_disk_image %}
{% set _usb_fmt = 'qcow2' if (item.usb_disk_image | lower).endswith('.qcow2') else 'raw' %}
{% set _ = _args.append('-device qemu-xhci,id=xhci') %}
{% set _ = _args.append('-drive if=none,id=usb0,format=' ~ _usb_fmt ~ ',file=' ~ item.usb_disk_image) %}
{% if item.usb_boot_priority %}
{% set _ = _args.append('-device usb-storage,drive=usb0,bootindex=1') %}
{% else %}
{% set _ = _args.append('-device usb-storage,drive=usb0') %}
{% endif %}
{% endif %}
{# ── UEFI firmware ───────────────────────────────────────── #}
{% if item.uefi %}
{% if item.secure_boot %}
{% set _ = _args.append('-drive if=pflash,format=raw,readonly=on,file=' ~ vms_ovmf_code_secboot) %}
{% set _ = _args.append('-drive if=pflash,format=raw,file=' ~ vms_image_dir ~ '/' ~ item.name ~ '_VARS.fd') %}
{% set _ = _args.append('-global driver=cfi.pflash01,property=secure,value=on') %}
{% else %}
{% set _ = _args.append('-drive if=pflash,format=raw,readonly=on,file=' ~ vms_ovmf_code) %}
{% set _ = _args.append('-drive if=pflash,format=raw,file=' ~ vms_image_dir ~ '/' ~ item.name ~ '_VARS.fd') %}
{% endif %}
{% endif %}
{# ── Emulated TPM ────────────────────────────────────────── #}
{% if item.tpm %}
{% set _ = _args.append('-chardev socket,id=chrtpm,path=' ~ vms_swtpm_state_dir ~ '/' ~ item.name ~ '/swtpm.sock') %}
{% set _ = _args.append('-tpmdev emulator,id=tpm0,chardev=chrtpm') %}
{% set _ = _args.append('-device tpm-tis,tpmdev=tpm0') %}
{% endif %}
{# ── SMBIOS type 11 OEM strings ──────────────────────────── #}
{% for _oem_string in item.smbios_oem_strings %}
{% set _ = _args.append('-smbios type=11,path=/var/lib/qemu/' ~ item.name ~ '/smbios/' ~ ('%02d' | format(loop.index0))) %}
{% endfor %}
{# ── Networking ──────────────────────────────────────────── #}
{% if item.net_mode == 'user' %}
{% set _ = _args.append('-nic user,model=virtio-net-pci,mac=' ~ item.mac_address) %}
{% elif item.net_mode == 'bridge' %}
{% set _ = _args.append('-netdev bridge,id=net0,br=' ~ item.net_bridge) %}
{% set _ = _args.append('-device virtio-net-pci,netdev=net0,mac=' ~ item.mac_address) %}
{% endif %}
QEMU_ARGS="{{ _args | join(' ') }}"
